{
  "_comment": "Шаблон настроек прогона обучения (не читается автоматически — это пример структуры). Реальные дефолты: rl/config.py (Config). Профиль наград: configs/reward_v4.json (канон). Экспериментальные наборы: configs/exp_*.json. Запуск: python train.py [аргументы] или make gui.",
  "_reward_profile": "configs/reward_v4.json (подхватывается автоматически; частичный JSON через --reward-config допустим — отсутствующие ключи берутся из канона)",

  "name": "my_run",
  "map_size": 280,
  "difficulty": "normal",
  "seed": 42,

  "n_envs": 8,
  "n_steps": 4096,
  "total_timesteps": 1000000,
  "batch_size": 8192,
  "n_epochs": 10,
  "learning_rate": 0.0003,
  "gamma": 0.999,
  "gae_lambda": 0.99,
  "clip_range": 0.2,
  "ent_coef": 0.01,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "target_kl": 0.02,
  "net_arch": [256, 256],

  "obs_mode": "flat",
  "obs_version": 2,
  "minimap_radius": 14,

  "curriculum_stage": 0,
  "curriculum_schedule": [],
  "unlock_ids": "",
  "use_curriculum_tab": false,
  "curriculum_resources": "",
  "tax_to_debt": true,
  "disabled_mechanics": ["improve_land", "preservation", "credit"],
  "mechanics_unlock_schedule": [[200000, ["improve_land", "preservation"]], [500000, ["credit"]]],

  "save_freq": 500000,
  "eval_freq": 100000,
  "eval_episodes": 20,
  "eval_seeds": [42],

  "device": "cuda",
  "use_amp": true,
  "amp_dtype": "bfloat16",
  "torch_compile": false,
  "cpp_threads": 0,
  "torch_threads": 0,
  "loop_detection_enabled": false,

  "log_dir": "~/colony_runs/logs",
  "model_dir": "~/colony_runs/models"
}
